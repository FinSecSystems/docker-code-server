#!/usr/bin/python3
# PAM helper for sudo (pam_exec, runs as root): checks the password typed at the sudo prompt against SUDO_PASSWORD_HASH from
# /run/secrets/code-auth.env (the compose file mounts code-auth.env there). The linuxserver init script cannot do this: it needs root at start
# (the container runs as uid 1000), targets the user "abc" and writes the hash into /etc/shadow, which does not take argon2 hashes.
# Accepts argon2i/argon2id/argon2d hashes (same format as HASHED_PASSWORD) and crypt(3) hashes ($6$, $5$, $y$, ...).
import ctypes
import hmac
import sys

CONF = "/run/secrets/code-auth.env"
password = sys.stdin.buffer.read().split(b"\0")[0].rstrip(b"\n") # allow-secret: read from stdin, not a literal
stored = None
try:
    for line in open(CONF):
        if line.startswith("SUDO_PASSWORD_HASH="):
            stored = line.split("=", 1)[1].strip().strip("'\"")
except OSError:
    sys.exit(1)
if not stored or not password:
    sys.exit(1)
if stored.startswith("$argon2"):
    kinds = {"argon2d": 0, "argon2i": 1, "argon2id": 2}
    kind = kinds.get(stored.split("$")[1])
    if kind is None:
        sys.exit(1)
    lib = ctypes.CDLL("libargon2.so.1")
    lib.argon2_verify.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_int]
    sys.exit(0 if lib.argon2_verify(stored.encode(), password, len(password), kind) == 0 else 1)
import crypt
sys.exit(0 if hmac.compare_digest(crypt.crypt(password.decode(errors="replace"), stored) or "", stored) else 1)
